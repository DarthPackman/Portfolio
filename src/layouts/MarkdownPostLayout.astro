---
import BaseLayout from './BaseLayout.astro';
import { fade } from "astro:transitions";
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description} image={frontmatter.image.url || undefined}>
  <p>{frontmatter.pubDate.toString().slice(0,15)}</p>
  <p transition:animate={fade({ duration: '300ms' })} ><em>{frontmatter.description}</em></p>
  <p>Written by: <a href="/about/">{frontmatter.author}</a></p>

  <img class="banner" src={frontmatter.image.url || '/DarthPackmanBanner.webp'} alt={frontmatter.image.url ? frontmatter.image.alt : 'DarthPackman banner'} />

  {frontmatter.video && (
    <video class="clip" src={frontmatter.video} controls muted loop playsinline preload="metadata" aria-label={"Gameplay clip of " + frontmatter.title}></video>
  )}

  <div class="tags">
    {frontmatter.tags.map((tag) => (
      <p class="tag"><a href={`/portfolio/?tag=${encodeURIComponent(tag)}`}>{tag}</a></p>
    ))}
  </div>

  <slot />
</BaseLayout>
<style is:global>
  .video { position: relative; aspect-ratio: 16 / 9; margin: 1rem 0; }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 0.75rem; }
</style>
<style>
  :global(main) { max-width: 52rem; }
  .clip { width: 100%; aspect-ratio: 16 / 9; border-radius: 0.75rem; margin-top: 0.75rem; background: #000; }
  .banner { width: 100%; max-height: 22rem; object-fit: cover; border-radius: 0.75rem; }

  a {
    color: #00539F;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;    
    padding: .5em 1em;
    font-size: 1.0em;
    background-color: #F8FCFD;
  }
</style>