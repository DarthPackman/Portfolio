---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "About Me";
const identity = {
  firstName: "Gavin",
  lastName: "Edwards",
  handle: "DarthPackman",
  country: "Canada",
  occupation: "Service Desk Analyst",
  education: "B.Sc. in Computer Science, Graduated with Distinction (3.89 GPA), Technical Theatre Certificate",
  hobbies: 
  ["Game Development",
  "Streaming & Content Creation",
  "Video Games", 
  "Board Games", 
  "War Games", 
  "Trading Card Games", 
  "Tabletop Roleplaying Games"],
  
};
const skills = 
["HTML", 
"CSS", 
"JavaScript", 
"C#", 
"C++",
"C",
"Java",
"Python",
"PHP",
"GDScript",
"Astro",
"React",
"Unity",
"Godot",
"Unreal Engine",
"MySQL",
"Firebase",
"Arduino",
"Figma",
"MARIE"];
---

<BaseLayout pageTitle={pageTitle}>
    <h2>About Me</h2>
    <p>I'm a Computer Science graduate and indie game developer based in {identity.country}, working across game development, web development, and hardware/IoT projects — from university coursework and capstones to game jams and ongoing personal projects.</p>
    <p>This site is connected to GitHub and Netlify, so it updates automatically.</p>
    <p>Here are a few facts about me:</p>
    <ul>
        <li>My name is {identity.firstName}.</li>
        <li>I live in {identity.country} and I work as a {identity.occupation}.</li>
        <li>I hold a {identity.education}.</li>
    </ul>
    <ul>
        <p>My hobbies are:</p>
        {identity.hobbies.map((hobby) => <li class="hobby">{hobby}</li>)}
    </ul>
    <ul>
        <p>My skills are:</p>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
</BaseLayout>