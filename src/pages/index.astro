---
import { getCollection } from "astro:content";
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const pageTitle = "Gavin Edwards";
// Paste the YouTube video ID of the demo reel here to show it on the homepage.
const reelId = "";
const latest = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout pageTitle={pageTitle}>
  <img class="hero" src="/DarthPackmanBanner.webp" alt="DarthPackman: Press Start" width="2560" height="423" />
  <h2>Game developer and Computer Science graduate.</h2>
  <p class="intro">I'm a Computer Science graduate (Graduated with Distinction, 3.89 GPA) with a Technical Theatre Certificate, working across game development, web development, and hardware/IoT projects — from university coursework and capstones to game jams and ongoing personal projects.</p>
  <p>
    <a class="btn" href="/portfolio">See my projects</a>
    <a class="btn alt" href="/about">About me</a>
  </p>
  {reelId && (
    <section aria-labelledby="reel-h">
      <h2 id="reel-h">Demo reel</h2>
      <div class="reel">
        <iframe src={`https://www.youtube-nocookie.com/embed/${reelId}`} title="Gavin Edwards game development demo reel" loading="lazy" allowfullscreen></iframe>
      </div>
    </section>
  )}
  <h2>Latest projects</h2>
  <div class="grid">
    {latest.map((post) => <PostCard post={post} />)}
  </div>
  <p><a href="/portfolio">View all projects →</a></p>
</BaseLayout>
<style>
  .hero { width: 100%; height: auto; border-radius: 0.75rem; display: block; margin-bottom: 1rem; }
  .grid { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 840px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .reel { aspect-ratio: 16 / 9; } .reel iframe { width: 100%; height: 100%; border: 0; border-radius: 0.75rem; }
  .intro { max-width: 60rem; }
  .btn { display: inline-block; padding: 0.6rem 1.2rem; margin-right: 0.5rem; border-radius: 999px; background: #CD4A04; color: #E4E3E2; text-decoration: none; }
  .btn.alt { background: transparent; border: 2px solid #CD4A04; color: inherit; }
</style>
